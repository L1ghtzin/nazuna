+/**
+ * Chainy stealth detection helper.
+ *
+ * Classifies a decryption error into one of three categories:
+ * - NO_SESSION      : Session missing (recoverable, usually lag/multi-device sync)
+ * - MAC             : MAC verification failed (session corrupted, potential attack)
+ * - BAD_KEY         : Invalid key / bad key (recoverable via key exchange)
+ * - GENERIC         : Anything else
+ *
+ * The classification is written into the messageStubParameters array
+ * (positions [1], [2]) so downstream anti-stealth consumers can decide
+ * without re-parsing the raw error message.
+ *
+ * @param {Error} error
+ * @returns {{ category: string, isRecoverable: boolean, code: string }}
+ */
+export const classifyDecryptionError = (error) => {
+    const message = (error?.message || error?.toString() || '').toLowerCase();
+    const isSessionRecord = DECRYPTION_RETRY_CONFIG.sessionRecordErrors.some(p => message.includes(p.toLowerCase()));
+    if (isSessionRecord || message.includes('no session found') || message.includes('session not found')) {
+        return { category: 'NO_SESSION', isRecoverable: true, code: 'no_session' };
+    }
+    // MAC = verificação de integridade falhou (sessão fora de sincronia).
+    // Match restrito às strings reais do Signal/rust-bridge para evitar
+    // falsos positivos que baniriam usuários legítimos (ex: "machine", "format").
+    if (message.includes('bad mac') || message.includes('failed to verify mac') || message.includes('mac verification failed')) {
+        return { category: 'MAC', isRecoverable: false, code: 'mac_failure' };
+    }
+    if (message.includes('invalid key') || message.includes('invalidkey') || message.includes('no prekey') || message.includes('prekey') || message.includes('invalid message') || message.includes('invalidmessage')) {
+        return { category: 'BAD_KEY', isRecoverable: true, code: 'bad_key' };
+    }
+    return { category: 'GENERIC', isRecoverable: true, code: 'generic' };
+};
